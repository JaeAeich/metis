{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT run_id, stream, seq, line, written_at\n            FROM log_lines\n            WHERE run_id = $1\n            AND ($2::text IS NULL OR stream = $2)\n            AND ($3::bigint IS NULL OR seq > $3)\n            ORDER BY seq ASC\n            LIMIT $4\n            ",
