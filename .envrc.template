# -----------------------------------------------------------------------------
# Rust Toolchain & Developer Environment
# -----------------------------------------------------------------------------
export RUSTUP_TOOLCHAIN=1.88.0
PATH_add ~/.cargo/bin

# -----------------------------------------------------------------------------
# Build Configuration
# -----------------------------------------------------------------------------
# These versions ensure reproducible builds across environments
export VERSION=0.1.0
export RUST_VERSION=1.88.0
export MIGRATE_VERSION=v4.17.0
export NEXTFLOW_VERSION=23.10.1

# Build metadata (typically injected by CI/CD)
export BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
export GIT_REVISION=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
export BUILD_TARGET=release  # Options: debug, release
export TARGET_ENV=tool

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
# Database credentials
export POSTGRES_USER=metis_user
export POSTGRES_PASSWORD=supersecretpassword
export POSTGRES_DB=metis
export POSTGRES_PORT=5432

# Full connection URL for application use
export DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# -----------------------------------------------------------------------------
# NATS Message Broker Configuration
# -----------------------------------------------------------------------------
# NATS server connection
export NATS_URL=nats://localhost:4222
export NATS_CLIENT_PORT=4222
export NATS_HTTP_PORT=8222

# NATS subject/topic configuration
export NATS_SUBJECT_PREFIX=metis.workflows

# -----------------------------------------------------------------------------
# Application Runtime Configuration
# -----------------------------------------------------------------------------
# API server settings
export API_PORT=8080
export API_HOST=0.0.0.0

# Logging configuration
export RUST_LOG=debug  # Options: error, warn, info, debug, trace
export RUST_BACKTRACE=1  # Set to 1 to enable stack traces

# -----------------------------------------------------------------------------
# Plugin/Worker Configuration
# -----------------------------------------------------------------------------
# Nextflow plugin settings
export NEXTFLOW_WORKER_CONCURRENCY=5
export NEXTFLOW_REPLICAS=1

# -----------------------------------------------------------------------------
# Docker Compose Profile Selection
# -----------------------------------------------------------------------------
# Determines which services to run
export COMPOSE_PROFILES=dev  # Options: dev, prod

# Docker Compose project name (avoids conflicts with other projects)
export COMPOSE_PROJECT_NAME=metis

# -----------------------------------------------------------------------------
# Development Helpers
# -----------------------------------------------------------------------------
# Color output for easier reading
export CLICOLOR=1
export CLICOLOR_FORCE=1

# -----------------------------------------------------------------------------
# End of .envrc
# -----------------------------------------------------------------------------
